*.pid
*.seed

# Server disk session exports (NeuroVis bridge)
data/session_recordings/

# Xcode — MuseBridge macOS project under swift-bridge/
# Keep .xcodeproj, shared schemes, and sources; ignore per-machine noise & local builds.
swift-bridge/MuseBridgeApp/**/xcuserdata/
swift-bridge/MuseBridgeApp/**/.xcuserstate
swift-bridge/MuseBridgeApp/**/DerivedData/
swift-bridge/MuseBridgeApp/**/XcodeDerivedData/
swift-bridge/MuseBridgeApp/**/build/
swift-bridge/MuseBridgeApp/**/*.moved-aside

# Python
.venv/
__pycache__/
*.pyc
